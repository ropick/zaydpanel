# ZaydPanel Agent - Environment Variables
# Copy this file to /opt/zaydpanel/.env and fill in the values

# Agent API secret (used for panel-agent communication)
ZAYDPANEL_AGENT_SECRET=change-me-to-random-string

# JWT secret for auth tokens
ZAYDPANEL_JWT_SECRET=change-me-to-random-string

# Password salt for hashing
ZAYDPANEL_PASSWORD_SALT=change-me-to-random-string

# Default admin password (optional - will auto-generate if empty)
ZAYDPANEL_ADMIN_PASSWORD=

# Agent port (default: 8442)
ZAYDPANEL_AGENT_PORT=8442
